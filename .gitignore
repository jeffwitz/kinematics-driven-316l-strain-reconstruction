# Local Python environment
.venv/

# Python bytecode and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
docs/_build/

# Packaging artifacts
build/
dist/
*.egg-info/

# Generated scientific inputs and results
data/processed/
results/

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
*~

# Session-resume shortcuts and a superseded patch, kept on disk but not tracked.
# `kinematics_extension_v1.diff` was applied by hand in July 2026; its content is
# in main and the diff no longer applies against any blob in the object store.
codex_session.txt
session_claude.txt
kinematics_extension_v1.diff

# Local code-index cache of the codebase-memory MCP server. Regenerated on
# demand, machine-specific, and a compressed binary: tracking it put an
# unreadable diff in every commit and, in a file-sync folder, invited conflicted
# copies. Untracked on 2026-08-03 with `git rm --cached`.
.codebase-memory/

# LaTeX build artefacts. The note in paper/ is compiled with xelatex and biber,
# which leave a dozen intermediate files next to the sources; only the sources
# and the built PDF are worth an history.
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.toc

# Trained weights: needed on disk for --load-weights re-scoring, never committed.
validation/_generated/**/*.weights

# Large/reproducible scratch products from the plastic-observability ladder.
# Their compact JSON summaries and the scripts that regenerate them are the
# versioned evidence; the full fields stay local.
validation/_generated/shared_tensor_generator/fcc_slip_fields.npz
validation/_generated/shared_tensor_generator/femu_smoke_*/
validation/_generated/shared_tensor_generator/krylov_trajectories.r*.npz
validation/_generated/shared_tensor_generator/probe200
validation/_generated/shared_tensor_generator/tann_fcc_p43_run.npz
